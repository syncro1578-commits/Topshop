# ============================================================
#  Topshop.tn — Variables d'environnement
#  Copiez ce fichier en .env.local pour le développement local
#  Sur Vercel/Netlify : ajoutez chaque variable dans le dashboard
# ============================================================

# ── Site ─────────────────────────────────────────────────────
# URL publique du frontend (sans slash final)
NEXT_PUBLIC_SITE_URL=https://shop.toprix.tn

# ── WooCommerce (backend boutique) ───────────────────────────
# URL du site WordPress/WooCommerce (sans slash final)
NEXT_PUBLIC_WC_URL=https://wc.toprix.tn

# Clés REST API WooCommerce
# WC Admin → WooCommerce → Paramètres → Avancé → REST API → Ajouter une clé
# Permissions requises : Lecture/Écriture
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Webhook WooCommerce ───────────────────────────────────────
# Secret aléatoire pour valider les webhooks WC entrants
# WC Admin → WooCommerce → Paramètres → Avancé → Webhooks
# URL webhook : https://shop.toprix.tn/api/webhook/wc-order
# Générer : openssl rand -base64 32
WEBHOOK_SECRET=votre_secret_aleatoire_ici

# ── SMTP — Envoi d'emails ─────────────────────────────────────
# Serveur mail serv00.com
SMTP_HOST=mail3.serv00.com
SMTP_PORT=587
# Votre adresse email sur serv00
SMTP_USER=topshop@oven-cleaner.serv00.net
# Mot de passe du compte email serv00
SMTP_PASSWORD=votre_mot_de_passe_smtp
# Nom et adresse expéditeur affichés dans les emails
SMTP_FROM=Topshop.tn <topshop@oven-cleaner.serv00.net>

# ── IndexNow (Bing/Yandex) ─────────────────────────────────────
# Clé de notification instantanée aux moteurs de recherche. Le fichier
# public/<clé>.txt doit exister avec cette même valeur comme contenu.
INDEXNOW_KEY=votre_cle_indexnow_ici

# ── Meta Conversions API ───────────────────────────────────────
# Events Manager → Pixel → API Conversions → Configurer une intégration directe
META_CAPI_ACCESS_TOKEN=votre_token_conversions_api_ici
